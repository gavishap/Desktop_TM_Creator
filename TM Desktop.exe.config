<?xml version="1.0" encoding="utf-8"?>
<!-- Ships next to TM Desktop.exe. Files extracted from a downloaded zip carry a
     mark-of-the-web, and .NET refuses to load the pythonnet assemblies the UI
     needs unless remote sources are allowed. Without this the app dies at
     "import clr" on any machine that downloaded the zip. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
